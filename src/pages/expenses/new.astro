---
import Layout from '@/layouts/Layout.astro';
import { getDb } from '@/db';
import { agents } from '@/db/schema';
import { EXPENSE_CATEGORIES } from '@/lib/expense';

export const prerender = false;

const isAdmin = Astro.locals.user?.role === 'admin';
const db = getDb(Astro.locals.runtime.env.DB);
const agentList = isAdmin ? await db.select({ id: agents.id, name: agents.name }).from(agents).orderBy(agents.name) : [];
const today = new Date().toISOString().slice(0, 10);

const field = 'mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500';
const label = 'block text-xs font-medium text-slate-600';
---

<Layout title="Cheltuială nouă">
  <div class="mx-auto max-w-2xl">
    <a href="/expenses" class="text-sm text-indigo-600 hover:underline">← Cheltuieli</a>
    <h1 class="mt-2 mb-6 text-2xl font-bold text-slate-900">Cheltuială nouă</h1>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <form method="POST" action="/api/expenses" class="space-y-4">
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class={label} for="date">Data</label>
            <input class={field} id="date" name="date" type="date" value={today} />
          </div>
          <div>
            <label class={label} for="category">Categorie *</label>
            <select class={field} id="category" name="category" required>
              {EXPENSE_CATEGORIES.map((c) => <option value={c}>{c}</option>)}
            </select>
          </div>
          <div>
            <label class={label} for="amount">Sumă (RON) *</label>
            <input class={field} id="amount" name="amount" type="number" step="0.01" min="0" required />
          </div>
          <div>
            <label class={label} for="liters">Litri (doar combustibil)</label>
            <input class={field} id="liters" name="liters" type="number" step="0.01" min="0" placeholder="ex. 45" />
          </div>
          {isAdmin && (
            <div class="sm:col-span-2">
              <label class={label} for="agentId">Agent</label>
              <select class={field} id="agentId" name="agentId">
                <option value="">— fără agent (firmă) —</option>
                {agentList.map((a) => <option value={a.id}>{a.name}</option>)}
              </select>
            </div>
          )}
          <div class="sm:col-span-2">
            <label class={label} for="description">Descriere</label>
            <input class={field} id="description" name="description" placeholder="ex. plin Petrom, deplasare client X" />
          </div>
        </div>
        <div class="flex gap-3">
          <button type="submit" class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">Adaugă cheltuiala</button>
          <a href="/expenses" class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50">Anulează</a>
        </div>
      </form>
    </div>
  </div>
</Layout>
