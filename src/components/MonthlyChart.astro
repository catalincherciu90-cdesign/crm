---
import type { MonthPoint } from '@/lib/targets';
import { formatMoney } from '@/lib/money';

interface Props {
  data: MonthPoint[];
  target?: number;
  title?: string;
}
const { data, target = 0, title = 'Evoluție lunară (oferte acceptate)' } = Astro.props;

const H = 140; // inaltimea zonei de plot in px
const max = Math.max(target, ...data.map((d) => d.realized), 1);
const barH = (v: number) => Math.round((v / max) * H);
const targetTop = target > 0 ? H - barH(target) : 0;
const color = (v: number) => (target > 0 && v >= target ? 'bg-green-500' : 'bg-indigo-500');
---

<div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="mb-4 flex items-center justify-between">
    <h2 class="text-xs font-semibold uppercase tracking-wide text-slate-400">{title}</h2>
    {target > 0 && (
      <span class="flex items-center gap-1 text-[11px] text-slate-500">
        <span class="inline-block h-0 w-4 border-t-2 border-dashed border-red-400"></span> target {formatMoney(target)}
      </span>
    )}
  </div>

  <div class="relative" style={`height:${H}px`}>
    {target > 0 && (
      <div class="absolute left-0 right-0 z-10 border-t-2 border-dashed border-red-400" style={`top:${targetTop}px`}></div>
    )}
    <div class="flex h-full items-end gap-2">
      {data.map((d) => (
        <div class="group relative flex flex-1 flex-col items-center justify-end">
          <span class="mb-1 text-[10px] font-medium text-slate-600 opacity-0 transition group-hover:opacity-100">{formatMoney(d.realized)}</span>
          <div class={`w-full rounded-t ${color(d.realized)} transition-all`} style={`height:${barH(d.realized)}px`}></div>
        </div>
      ))}
    </div>
  </div>

  <div class="mt-2 flex gap-2">
    {data.map((d) => (
      <div class="flex-1 text-center text-[11px] capitalize text-slate-500">{d.label}</div>
    ))}
  </div>
</div>
