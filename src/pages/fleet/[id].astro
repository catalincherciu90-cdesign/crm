---
import { asc, eq, and, sql } from 'drizzle-orm';
import Layout from '@/layouts/Layout.astro';
import VehicleForm from '@/components/VehicleForm.astro';
import { getDb } from '@/db';
import { vehicles, agents, expenses } from '@/db/schema';
import { formatMoney } from '@/lib/money';
import { docStatus } from '@/lib/fleet';

export const prerender = false;

const id = Number(Astro.params.id);
const db = getDb(Astro.locals.runtime.env.DB);
const [vehicle] = await db.select().from(vehicles).where(eq(vehicles.id, id));
if (!vehicle) return Astro.redirect('/fleet');

const agentList = await db.select({ id: agents.id, name: agents.name }).from(agents).orderBy(asc(agents.name));

// Combustibil luna curenta pentru aceasta masina
const [fuel] = await db
  .select({ total: sql<number>`coalesce(sum(amount),0)`, liters: sql<number>`coalesce(sum(liters),0)`, n: sql<number>`count(*)` })
  .from(expenses)
  .where(and(eq(expenses.vehicleId, id), eq(expenses.category, 'Combustibil'), sql`strftime('%Y-%m', date) = strftime('%Y-%m','now')`));

const docs: [string, string | null][] = [
  ['ITP', vehicle.itpExpiry],
  ['RCA', vehicle.rcaExpiry],
  ['Rovinietă', vehicle.rovinietaExpiry],
  ['CASCO', vehicle.cascoExpiry],
];
---

<Layout title={vehicle.plate}>
  <div class="mx-auto max-w-3xl">
    <a href="/fleet" class="text-sm text-indigo-600 hover:underline">← Parc auto</a>
    <h1 class="mt-2 text-2xl font-bold text-slate-900">{vehicle.plate}</h1>
    <p class="mb-6 text-sm text-slate-500">{[vehicle.make, vehicle.model, vehicle.year].filter(Boolean).join(' ')}</p>

    <!-- Rezumat documente + combustibil -->
    <div class="mb-6 grid gap-4 sm:grid-cols-2">
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-400">Documente</h2>
        <ul class="space-y-2 text-sm">
          {docs.map(([name, d]) => {
            const s = docStatus(d);
            return (
              <li class="flex items-center justify-between">
                <span class="text-slate-600">{name}</span>
                <span class="flex items-center gap-2">
                  <span class="text-xs text-slate-400">{d ?? '—'}</span>
                  <span class={`rounded-full px-2 py-0.5 text-[11px] font-medium ${s.cls}`}>{s.label}</span>
                </span>
              </li>
            );
          })}
        </ul>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-400">⛽ Combustibil (luna curentă)</h2>
        <div class="text-2xl font-bold text-slate-900">{formatMoney(fuel.total)}</div>
        <p class="mt-1 text-sm text-slate-500">{fuel.liters > 0 ? `${fuel.liters.toFixed(0)} litri · ` : ''}{fuel.n} alimentări</p>
        <a href="/expenses/new" class="mt-3 inline-block text-sm text-indigo-600 hover:underline">+ Adaugă cheltuială combustibil</a>
      </div>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="mb-4 font-semibold text-slate-900">Editează mașina</h2>
      <VehicleForm vehicle={vehicle} agents={agentList} />
    </div>

    <div class="mt-4 flex justify-end">
      <form method="POST" action="/api/vehicles" onsubmit={`return confirm('Ștergi mașina ${vehicle.plate}?')`}>
        <input type="hidden" name="id" value={id} />
        <input type="hidden" name="delete" value="1" />
        <button type="submit" class="rounded-lg border border-red-200 bg-red-50 px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-100">🗑 Șterge mașina</button>
      </form>
    </div>
  </div>
</Layout>
